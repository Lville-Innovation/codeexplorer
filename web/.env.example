# Copy to .env.local and fill in your own values. Never commit the filled-in file.

# Password visitors must type before they can use the site.
SITE_PASSWORD=

# LiveKit project (voice and video rooms).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenRouter key, used to write the notes about each repo.
OPENROUTER_API_KEY=

# BunnyCDN storage zone where learned repos are cached.
BUNNYCDN_STORAGE_ZONE_NAME=
BUNNYCDN_ACCESS_KEY=
BUNNYCDN_REGION=

# Optional. A GitHub token makes contributor data more reliable.
GITHUB_TOKEN=
# Optional overrides.
LEARN_MODEL=
REPO_BUDDY_AGENT_NAME=
