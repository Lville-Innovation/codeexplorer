# Copy to .env.local and fill in your own values. Never commit the filled-in file.

# LiveKit project (must be the same project the website uses).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LemonSlice key for the talking avatar video.
LEMONSLICE_API_KEY=

# Deepgram key for hearing the student and for Pixel's voice.
DEEPGRAM_API_KEY=

# OpenRouter key for the model that answers questions.
OPENROUTER_API_KEY=

# BunnyCDN storage zone where the website cached the learned repos (same values as the website).
BUNNYCDN_STORAGE_ZONE_NAME=
BUNNYCDN_ACCESS_KEY=
BUNNYCDN_REGION=

# Optional overrides.
AGENT_MODEL=
DEEPGRAM_VOICE=
REPO_BUDDY_AGENT_NAME=
